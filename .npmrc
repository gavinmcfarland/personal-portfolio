# Don't let pnpm try to self-install the version in the `packageManager` field.
# This machine has several pnpm installs (Volta 10.x, PNPM_HOME 9.x, nvm 9.x);
# the self-switch shells a nested `pnpm add … --allow-build …` that lands on a
# pnpm 9, which rejects the pnpm-10-only `--allow-build` flag and aborts install.
manage-package-manager-versions=false
