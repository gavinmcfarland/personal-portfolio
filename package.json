{
  "name": "vibe-code-portfolio",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter portfolio dev",
    "build": "pnpm --filter portfolio build",
    "canvas:demo": "pnpm --filter @gavinmcfarland/canvas demo",
    "dither:demo": "pnpm --filter @gavinmcfarland/dither demo",
