          "z": 2,
          "w": 300,
          "text": "# Askeroo\n\nThe first stateful CLI that allows back navigation. I created Askeroo after wishing more from the prompt wizards that were avaiable. I wanted something modular and configurable for different needs."
        },
        {
          "id": "note-0",
          "type": "sticky",
          "x": 1286.730577879636,
          "y": -335.59325053687246,
          "z": 3,
          "color": "pink",
          "text": "Highly configurable default prompts"
        },
        {
          "id": "note-1",
          "type": "sticky",
          "x": 1286.730577879636,
          "y": 200.3966296388496,
          "z": 4,
          "color": "orange",
          "text": "Create your own prompts using the Ink library"
        },
        {
          "id": "note-2",
          "type": "sticky",
          "x": 1286.730577879636,
          "y": -72.74697178486929,
          "z": 5,
          "color": "purple",
          "text": "Built-in task runners for long-running steps"
        },
        {
          "id": "n4-code",
          "type": "code",
          "x": 317.360598924952,
          "y": 481.7783246062023,
          "z": 8,
          "w": 420,
          "text": "// Your flow function runs multiple times\nconst flow = async () => {\n  const role = await radio({\n      label: \"Select your role\",\n      options: [\"Developer\", \"Designer\"],\n  });\n\n  if (role === \"Developer\") {\n    const language = await radio({\n        label: \"Preferred language\",\n        options: [\"TypeScript\", \"JavaScript\"],\n    });\n    return { role, language };\n  }\n\n  const tool = await radio({\n      label: \"Design tool\",\n      options: [\"Figma\", \"Sketch\"],\n  });\n  return { role, tool };\n};",
          "lang": "js"
        },
        {
          "id": "n7-code",
          "type": "code",
          "x": -540.211987725601,
          "y": 267.8004779926555,
          "z": 11,
          "w": 420,
          "text": "const flow = async () => {\n  const name = await text({\n      message: \"Name\",\n  });\n  return { name };\n}\n\nconst result = await ask(flow);",
          "lang": "js"
        },
        {
          "id": "n8-md",
          "type": "md",
          "x": -263.1241433208264,
          "y": 442.18323750415766,
          "z": 12,
          "w": 340,
          "text": "A flow is simply an object made up of prompts. Run these prompts by calling the object with `ask()`."
        },
