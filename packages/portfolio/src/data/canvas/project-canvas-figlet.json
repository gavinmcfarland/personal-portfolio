          "y": 668.1160208534303,
          "z": 42,
          "text": "Dynamic window widths",
          "fontSize": 52,
          "font": "script"
        },
        {
          "id": "n17-md",
          "type": "md",
          "x": 1097.3376959304435,
          "y": 358.619195809304,
          "z": 43,
          "w": 340,
          "text": "If you want to learn how Figma plugin's work there is are interactive tutorials that walk you through how plugins work."
        },
        {
          "id": "n18-md",
          "type": "md",
          "x": 437.2795534482199,
          "y": 358.619195809304,
          "z": 45,
          "w": 340,
          "text": "Figlet lets you run Figma API code inside Figma requiring no local setup."
